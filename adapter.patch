+@router.get("/api/pty/session")
+def active_pty_session(request: Request, channel: str, profile: Optional[str] = None):
+    """Read-only conversation identity for page widgets, including fresh chats.
+
+    Only an existing channel marker is read. Verify it belongs to the requested
+    profile before exposing it; never guess the newest conversation.
+    """
+    import sqlite3
+    from contextlib import closing
+    from hermes_constants import get_hermes_home
+    from hermes_cli.web_server import _get_pty_active_session_files
+    from hermes_cli.web_server_profiles import _config_profile_scope
+
+    if not _VALID_CHANNEL_RE.fullmatch(channel):
+        raise HTTPException(400, "Invalid chat channel.")
+    marker = _get_pty_active_session_files(request.app).get(channel)
+    sid = _read_active_session_file(marker) if marker else None
+    if not sid:
+        return {"session_id": None}
+    with _config_profile_scope(profile):
+        database = get_hermes_home() / "state.db"
+        if not database.is_file():
+            return {"session_id": None}
+        with closing(sqlite3.connect(database.resolve().as_uri() + "?mode=ro", uri=True, timeout=2)) as conn:
+            row = conn.execute("SELECT id FROM sessions WHERE id=?", (sid,)).fetchone()
+    return {"session_id": row[0] if row else None}
+
+
 def _ws_close_reason(text: str) -> str:
